---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import Tag from './Tag.astro';

interface Props {
	section: CollectionEntry<'sections'>;
	entries: CollectionEntry<'skills'>[];
}

const { section, entries } = Astro.props;
const { Content: SectionIntro } = await render(section);

const cards = await Promise.all(
	[...entries]
		.sort((a, b) => a.data.order - b.data.order)
		.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const icons: Record<string, string> = {
	monitor:
		'M9 17H7A5 5 0 017 7h2m6 10h2a5 5 0 000-10h-2M3 12h.01M21 12h.01M8 12h8',
	server:
		'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01',
	system:
		'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
};
---

<section id="skills" class="scroll-mt-16">
	<div class="mx-auto max-w-6xl px-6 py-24">
		<SectionHeading number={section.data.number} title={section.data.title}>
			<SectionIntro />
		</SectionHeading>

		<div class="grid gap-5 md:grid-cols-2">
			{
				cards.map(({ entry, Content }) => (
					<article
						class:list={[
							'rounded-md border border-line bg-ink-800/50 p-7 transition-colors hover:border-accent/40',
							entry.data.wide && 'md:col-span-2',
						]}
					>
						<div class:list={[entry.data.wide && 'md:grid md:grid-cols-2 md:items-center md:gap-12']}>
							<div>
								<div class="mb-4 flex items-center gap-3">
									<svg
										class="h-5 w-5 text-accent"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
										stroke-width="1.5"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											d={icons[entry.data.icon] ?? icons.monitor}
										/>
									</svg>
									<h3 class="text-lg font-bold text-white">{entry.data.title}</h3>
								</div>

								<div class="md-body mb-6 text-sm leading-relaxed text-fog">
									<Content />
								</div>

								<div class="flex flex-wrap gap-2">
									{entry.data.tags.map((tag) => (
										<Tag label={tag} />
									))}
								</div>
							</div>

							{entry.data.wide && (
								<div class="mt-10 hidden items-center justify-between md:mt-0 md:flex" aria-hidden="true">
									<div class="flex flex-col items-center gap-2">
										<div class="flex h-12 w-12 rotate-45 items-center justify-center border border-accent/50 bg-ink-950">
											<span class="-rotate-45 font-mono text-[10px] text-accent">UI</span>
										</div>
									</div>
									<div class="h-px flex-1 bg-gradient-to-r from-accent/50 via-line to-accent/50" />
									<div class="flex h-11 w-11 items-center justify-center rounded-full border border-accent/50 bg-ink-950">
										<span class="font-mono text-[10px] text-accent">API</span>
									</div>
									<div class="h-px flex-1 bg-gradient-to-r from-accent/50 via-line to-accent/50" />
									<div class="flex h-11 w-11 items-center justify-center rounded-sm border border-accent/50 bg-ink-950">
										<span class="font-mono text-[10px] text-accent">DB</span>
									</div>
								</div>
							)}
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
