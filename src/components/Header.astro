---
interface Props {
	cvLabel?: string;
	cvHref?: string;
	currentLocale?: 'en' | 'pt';
}

const { cvLabel = 'CV', cvHref = '/cv', currentLocale = 'en' } = Astro.props;

const links =
	currentLocale === 'pt'
		? [
			{ label: 'Início', href: '#hero' },
			{ label: 'Habilidades', href: '#skills' },
			{ label: 'Experiência', href: '#experiences' },
			{ label: 'Stack', href: '#stack' },
		]
		: [
			{ label: 'Hero', href: '#hero' },
			{ label: 'Skills', href: '#skills' },
			{ label: 'Experiences', href: '#experiences' },
			{ label: 'Stack', href: '#stack' },
		];

const alternateLocale =
	currentLocale === 'pt' ? { href: '/', label: 'EN' } : { href: '/pt', label: 'PT' };
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line/60 bg-ink-950/80 backdrop-blur-md">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
		<a href="#hero" class="text-base font-bold tracking-tight text-white">
			Gabriel Camargo<span class="text-accent">.</span>
		</a>

		<nav class="hidden items-center gap-8 font-mono text-xs text-fog md:flex">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="border-b-2 border-transparent pb-1 transition-colors hover:border-accent hover:text-white"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-3">
			<a
				href={alternateLocale.href}
				class="font-mono text-[10px] uppercase tracking-[0.2em] text-fog transition-colors hover:text-white"
			>
				{alternateLocale.label}
			</a>
			<a
				href={cvHref}
				class="rounded-sm border border-accent px-4 py-2 font-mono text-xs font-medium text-accent transition-colors hover:bg-accent hover:text-ink-950"
			>
				{cvLabel}
			</a>
		</div>
	</div>
</header>
