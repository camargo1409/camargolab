---
interface Props {
	number?: string;
	title: string;
}

const { number, title } = Astro.props;
---

<div class="mb-3 flex items-baseline gap-3">
	{number && <span class="font-mono text-sm font-medium text-accent">{number}.</span>}
	<h2 class="text-3xl font-bold tracking-tight text-white">{title}</h2>
</div>
<div class="mb-10 text-sm text-fog">
	<slot />
</div>
